{
  "name": "game-runtime-rn",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "build:android": "cd android && ./gradlew bundleRelease",
    "validate": "tsx scripts/validate.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.14",
    "expo-audio": "~58.0.9",
    "expo-build-properties": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-iap": "^6.1.0",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-google-mobile-ads": "^17.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0"
  },
  "comment": "Base runtime for UI-centric games (PRD §11.1). Expo SDK 58. The Claude Code builder fills game.config.json and src/game/* per the GDD; src/modules/{ads,iap,analytics,store} are the production monetization layer and must stay."
}
